[
  {
    "name": "post",
    "display_name": "Post",
    "schema": {
      "title": {
        "type": "text",
        "required": true,
        "pos": 0
      },
      "excerpt": {
        "type": "textarea",
        "pos": 1
      },
      "cover_image": {
        "type": "asset",
        "filetypes": [
          "images"
        ],
        "pos": 2
      },
      "published_at": {
        "type": "datetime",
        "pos": 3
      },
      "author": {
        "type": "option",
        "source": "internal_stories",
        "filter_content_type": [
          "author"
        ],
        "use_uuid": true,
        "pos": 4
      },
      "categories": {
        "type": "options",
        "source": "internal_stories",
        "filter_content_type": [
          "category"
        ],
        "use_uuid": true,
        "pos": 5
      },
      "tags": {
        "type": "options",
        "source": "internal",
        "datasource_slug": "tags",
        "pos": 6
      },
      "body": {
        "type": "richtext",
        "restrict_components": true,
        "component_whitelist": [
          "code_block",
          "callout",
          "pull_quote",
          "image_figure"
        ],
        "pos": 7
      },
      "seo_title": {
        "type": "text",
        "pos": 8
      },
      "seo_description": {
        "type": "textarea",
        "pos": 9
      },
      "og_image": {
        "type": "asset",
        "filetypes": [
          "images"
        ],
        "pos": 10
      }
    },
    "is_root": true,
    "is_nestable": false,
    "color": null,
    "icon": null,
    "preview_field": "title"
  },
  {
    "name": "author",
    "display_name": "Author",
    "schema": {
      "name": {
        "type": "text",
        "required": true,
        "pos": 0
      },
      "role": {
        "type": "text",
        "pos": 1
      },
      "bio": {
        "type": "textarea",
        "pos": 2
      },
      "avatar": {
        "type": "asset",
        "filetypes": [
          "images"
        ],
        "pos": 3
      },
      "website": {
        "type": "multilink",
        "pos": 4
      },
      "github": {
        "type": "text",
        "pos": 5
      }
    },
    "is_root": true,
    "is_nestable": false,
    "color": null,
    "icon": null,
    "preview_field": "name"
  },
  {
